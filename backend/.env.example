PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback provider - used automatically if Groq errors out (rate limit,
# outage, etc). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
