PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# Caps the DB connection pool AND the request threadpool that feeds it
# (app/storage/db.py, app/api/main.py). Defaults to 16.
DB_MAX_CONNECTIONS=16

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider - used automatically if Groq errors out (rate limit,
# outage, etc). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# Logging. Logs always go to stdout; LOG_FILE additionally writes to a
# rotating file, which is useful locally and pointless on a platform with
# an ephemeral filesystem. Relative paths resolve against backend/.
LOG_FILE=dump.log
LOG_LEVEL=INFO

# Cross-encoder reranking of retrieved reviews. Off by default: it lifts judged
# relevance substantially (0.364 -> 0.606 on the hybrid eval) but costs ~2s per
# vibe query and ~90MB for a second model. Set to 1 on hardware that can spare
# it; see backend/evaluation/EVALUATION.md for both scorecards.
RERANK_ENABLED=0
